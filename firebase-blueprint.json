  "firestore": {
    "/slit_inbound/{recordId}": {
      "schema": "SlitInboundRecord",
      "description": "Collection of scanned inbound slit coils"
    },
    "/slit_outbound/{recordId}": {
      "schema": "SlitOutboundRecord",
      "description": "Collection of dispatched outbound slit coils"
    },
    "/slit_picklists/{orderId}": {
      "schema": "SlitPickListOrder",
      "description": "Collection of dispatch pick lists"
    },
    "/slit_sap_chunks/{chunkId}": {
      "schema": "SlitSapChunk",
      "description": "Collection of bundled SAP Master Data chunks"
    },
    "/slit_space_config/{configId}": {
      "schema": "SlitWarehouseSpaceConfig",
      "description": "Collection of warehouse space configurations, basket layouts, and real-time space summary metrics"
    },
    "/coil_stock/{recordId}": {
      "schema": "CoilStockRecord",
      "description": "Dedicated collection for steel coil inventory stock"
    },
    "/coil_transactions/{txId}": {
      "schema": "CoilTransactionRecord",
      "description": "Dedicated collection for steel coil transactions (+inbound, issue, -staging, relocate)"
    },
    "/coil_staging/{stagingId}": {
      "schema": "CoilStagingOrder",
      "description": "Dedicated collection for steel coil staging and pick list orders"
    },
    "/coil_layouts/{layoutId}": {
      "schema": "CoilLayoutZone",
      "description": "Dedicated collection for steel coil storage layouts and bay capacities"
    },
    "/coil_sap_chunks/{chunkId}": {
      "schema": "CoilSapChunk",
      "description": "Dedicated collection for steel coil SAP master data chunks"
    },
    "/mh_transfers/{transferId}": {
      "schema": "MhTransferRecord",
      "description": "Dedicated collection for Material Handling transport operations"
    },
    "/mh_maintenance/{maintenanceId}": {
      "schema": "MhMaintenanceRecord",
      "description": "Dedicated collection for Material Handling maintenance and repair work orders"
    },
    "/mh_fuel_stock/{fuelTxId}": {
      "schema": "MhFuelStockRecord",
      "description": "Dedicated collection for Material Handling fuel stock inbound and outbound records"
    },
    "/mh_tire_stock/{tireTxId}": {
      "schema": "MhTireStockRecord",
      "description": "Dedicated collection for Material Handling tire stock inbound and replacement records"
    }
  }
}
