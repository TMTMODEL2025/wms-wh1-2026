rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInboundRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 32
        && data.location is string && data.location.size() <= 64;
    }

    function isValidOutboundRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 32
        && data.location is string && data.location.size() <= 64;
    }

    function isValidPickList(data) {
      return data.id is string && data.id.size() <= 128
        && data.orderNo is string && data.orderNo.size() <= 64;
    }

    function isValidSapChunk(data) {
      return data.id is string && data.id.size() <= 128
        && data.chunkIndex is number
        && data.items is list && data.items.size() <= 1000;
    }

    function isValidSpaceConfig(data) {
      return data.id is string && data.id.size() <= 128;
    }

    function isValidCoilStock(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 64
        && data.location is string && data.location.size() <= 64;
    }

    function isValidCoilTransaction(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 64
        && data.txType is string && data.txType.size() <= 32;
    }

    function isValidCoilStaging(data) {
      return data.id is string && data.id.size() <= 128
        && data.orderNo is string && data.orderNo.size() <= 64;
    }

    function isValidCoilLayout(data) {
      return data.id is string && data.id.size() <= 128
        && data.bayCode is string && data.bayCode.size() <= 64;
    }

    function isValidCoilSapChunk(data) {
      return data.id is string && data.id.size() <= 128
        && data.chunkIndex is number
        && data.items is list && data.items.size() <= 1000;
    }

    function isValidMhTransfer(data) {
      return data.id is string && data.id.size() <= 128
        && data.transferCode is string && data.transferCode.size() <= 64;
    }

    function isValidMhMaintenance(data) {
      return data.id is string && data.id.size() <= 128
        && data.workOrderNo is string && data.workOrderNo.size() <= 64;
    }

    function isValidMhFuelStock(data) {
      return data.id is string && data.id.size() <= 128
        && data.transactionNo is string && data.transactionNo.size() <= 64;
    }

    function isValidMhTireStock(data) {
      return data.id is string && data.id.size() <= 128
        && data.transactionNo is string && data.transactionNo.size() <= 64;
    }

    function isValidMhDailyDuty(data) {
      return data.id is string && data.id.size() <= 128
        && data.workingDate is string && data.workingDate.size() <= 32
        && data.employeeName is string && data.employeeName.size() <= 128
        && data.workArea is string && data.workArea.size() <= 128
        && data.vehicleNumber is string && data.vehicleNumber.size() <= 64
        && data.shift is string && data.shift.size() <= 64
        && data.team is string && data.team.size() <= 64;
    }

    function isValidMhDeliveryPoint(data) {
      return data.id is string && data.id.size() <= 128
        && data.deliveryPoint is string && data.deliveryPoint.size() > 0 && data.deliveryPoint.size() <= 128
        && data.gate is string && data.gate.size() <= 64;
    }

    function isValidWmsEmployee(data) {
      return data.id is string && data.id.size() <= 128
        && data.employeeId is string && data.employeeId.size() <= 64
        && data.employeeName is string && data.employeeName.size() <= 128
        && data.role is string && data.role.size() <= 32
        && data.employmentStatus in ['Active', 'Inactive']
        && (!('allowedSections' in data) || (data.allowedSections is list && data.allowedSections.size() <= 10));
    }

    function isValidWmsActivityLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.employeeId is string && data.employeeId.size() <= 64
        && data.employeeName is string && data.employeeName.size() <= 128
        && data.sectionId is string && data.sectionId.size() <= 32
        && data.module is string && data.module.size() <= 128
        && data.activity is string && data.activity.size() <= 500;
    }

    match /slit_inbound/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidInboundRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /slit_outbound/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidOutboundRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /slit_picklists/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) && isValidPickList(request.resource.data);
      allow delete: if isValidId(orderId);
    }

    match /slit_sap_chunks/{chunkId} {
      allow read: if true;
      allow create, update: if isValidId(chunkId) && isValidSapChunk(request.resource.data);
      allow delete: if isValidId(chunkId);
    }

    match /slit_space_config/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && isValidSpaceConfig(request.resource.data);
      allow delete: if isValidId(configId);
    }

    match /coil_stock/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidCoilStock(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /coil_transactions/{txId} {
      allow read: if true;
      allow create, update: if isValidId(txId) && isValidCoilTransaction(request.resource.data);
      allow delete: if isValidId(txId);
    }

    match /coil_staging/{stagingId} {
      allow read: if true;
      allow create, update: if isValidId(stagingId) && isValidCoilStaging(request.resource.data);
      allow delete: if isValidId(stagingId);
    }

    match /coil_layouts/{layoutId} {
      allow read: if true;
      allow create, update: if isValidId(layoutId) && isValidCoilLayout(request.resource.data);
      allow delete: if isValidId(layoutId);
    }

    match /coil_sap_chunks/{chunkId} {
      allow read: if true;
      allow create, update: if isValidId(chunkId) && isValidCoilSapChunk(request.resource.data);
      allow delete: if isValidId(chunkId);
    }

    match /mh_transfers/{transferId} {
      allow read: if true;
      allow create, update: if isValidId(transferId) && isValidMhTransfer(request.resource.data);
      allow delete: if isValidId(transferId);
    }

    match /mh_maintenance/{maintenanceId} {
      allow read: if true;
      allow create, update: if isValidId(maintenanceId) && isValidMhMaintenance(request.resource.data);
      allow delete: if isValidId(maintenanceId);
    }

    match /mh_fuel_stock/{fuelTxId} {
      allow read: if true;
      allow create, update: if isValidId(fuelTxId) && isValidMhFuelStock(request.resource.data);
      allow delete: if isValidId(fuelTxId);
    }

    match /mh_tire_stock/{tireTxId} {
      allow read: if true;
      allow create, update: if isValidId(tireTxId) && isValidMhTireStock(request.resource.data);
      allow delete: if isValidId(tireTxId);
    }

    match /mh_daily_duty/{dutyId} {
      allow read: if true;
      allow create, update: if isValidId(dutyId) && isValidMhDailyDuty(request.resource.data);
      allow delete: if isValidId(dutyId);
    }

    match /mh_delivery_points/{pointId} {
      allow read: if true;
      allow create, update: if isValidId(pointId) && isValidMhDeliveryPoint(request.resource.data);
      allow delete: if isValidId(pointId);
    }

    match /wms_employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidId(employeeId) && isValidWmsEmployee(request.resource.data);
      allow delete: if isValidId(employeeId);
    }

    match /wms_activity_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && isValidWmsActivityLog(request.resource.data);
      allow delete: if isValidId(logId);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
