rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInboundRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 32
        && data.location is string && data.location.size() <= 64;
    }

    function isValidOutboundRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 32
        && data.location is string && data.location.size() <= 64;
    }

    function isValidPickList(data) {
      return data.id is string && data.id.size() <= 128
        && data.orderNo is string && data.orderNo.size() <= 64;
    }

    function isValidSapChunk(data) {
      return data.id is string && data.id.size() <= 128
        && data.chunkIndex is number
        && data.items is list && data.items.size() <= 1000;
    }

    function isValidSpaceConfig(data) {
      return data.id is string && data.id.size() <= 128;
    }

    function isValidCoilStock(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 64
        && data.location is string && data.location.size() <= 64;
    }

    function isValidCoilTransaction(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 64
        && data.txType is string && data.txType.size() <= 32;
    }

    function isValidCoilStaging(data) {
      return data.id is string && data.id.size() <= 128
        && data.orderNo is string && data.orderNo.size() <= 64;
    }

    function isValidCoilLayout(data) {
      return data.id is string && data.id.size() <= 128
        && data.bayCode is string && data.bayCode.size() <= 64;
    }

    function isValidCoilSapChunk(data) {
      return data.id is string && data.id.size() <= 128
        && data.chunkIndex is number
        && data.items is list && data.items.size() <= 1000;
    }

    function isValidRmStock(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 128
        && data.location is string && data.location.size() <= 64;
    }

    function isValidRmTransaction(data) {
      return data.id is string && data.id.size() <= 128
        && data.batch is string && data.batch.size() <= 128
        && data.txType is string && data.txType.size() <= 32;
    }

    function isValidRmStaging(data) {
      return data.id is string && data.id.size() <= 128
        && data.orderNo is string && data.orderNo.size() <= 64;
    }

    function isValidRmLayout(data) {
      return data.id is string && data.id.size() <= 128
        && data.bayCode is string && data.bayCode.size() <= 64;
    }

    function isValidRmSapChunk(data) {
      return data.id is string && data.id.size() <= 128
        && data.chunkIndex is number
        && data.items is list && data.items.size() <= 1000;
    }

    function isValidMhTransfer(data) {
      return data.id is string && data.id.size() <= 128
        && data.transferCode is string && data.transferCode.size() <= 64;
    }

    function isValidMhMaintenance(data) {
      return data.id is string && data.id.size() <= 128
        && data.workOrderNo is string && data.workOrderNo.size() <= 64
        && (!('requesterName' in data) || (data.requesterName is string && data.requesterName.size() <= 128))
        && (!('vendorName' in data) || (data.vendorName is string && data.vendorName.size() <= 128))
        && (!('vehicleId' in data) || (data.vehicleId is string && data.vehicleId.size() <= 64))
        && (!('repairType' in data) || (data.repairType is string && data.repairType.size() <= 128))
        && (!('repairDescription' in data) || (data.repairDescription is string && data.repairDescription.size() <= 1000))
        && (!('workflowStage' in data) || (data.workflowStage is string && data.workflowStage.size() <= 64))
        && (!('supervisorStatus' in data) || (data.supervisorStatus is string && data.supervisorStatus.size() <= 64))
        && (!('managerStatus' in data) || (data.managerStatus is string && data.managerStatus.size() <= 64))
        && (!('partsCost' in data) || (data.partsCost is number && data.partsCost >= 0))
        && (!('laborCost' in data) || (data.laborCost is number && data.laborCost >= 0))
        && (!('estimatedCost' in data) || (data.estimatedCost is number && data.estimatedCost >= 0))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('supervisorNotes' in data) || (data.supervisorNotes is string && data.supervisorNotes.size() <= 1000))
        && (!('spareParts' in data) || (data.spareParts is list && data.spareParts.size() <= 100))
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 9 && (data.photos.size() == 0 || (data.photos[0] is map && data.photos[0].dataUrl is string && data.photos[0].dataUrl.size() <= 350000))));
    }

    function isValidMhFuelStock(data) {
      return data.id is string && data.id.size() <= 128
        && data.transactionNo is string && data.transactionNo.size() <= 64;
    }

    function isValidMhTireStock(data) {
      return data.id is string && data.id.size() <= 128
        && data.transactionNo is string && data.transactionNo.size() <= 64;
    }

    function isValidMhDailyDuty(data) {
      return data.id is string && data.id.size() <= 128
        && data.workingDate is string && data.workingDate.size() <= 32
        && data.employeeName is string && data.employeeName.size() <= 128
        && data.workArea is string && data.workArea.size() <= 128
        && data.vehicleNumber is string && data.vehicleNumber.size() <= 64
        && data.shift is string && data.shift.size() <= 64
        && data.team is string && data.team.size() <= 64
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 32));
    }

    function isValidMhDeliveryPoint(data) {
      return data.id is string && data.id.size() <= 128
        && data.deliveryPoint is string && data.deliveryPoint.size() > 0 && data.deliveryPoint.size() <= 128
        && data.gate is string && data.gate.size() <= 64;
    }

    function isValidMhPmSchedule(data) {
      return data.id is string && data.id.size() <= 128
        && data.vehicleId is string && data.vehicleId.size() > 0 && data.vehicleId.size() <= 64
        && data.pmCategory is string && data.pmCategory.size() <= 128
        && (!('cycleDays' in data) || (data.cycleDays is number && data.cycleDays >= 0 && data.cycleDays <= 3650))
        && (!('cycleMileageKm' in data) || (data.cycleMileageKm is number && data.cycleMileageKm >= 0 && data.cycleMileageKm <= 1000000))
        && (!('startMileageKm' in data) || (data.startMileageKm is number && data.startMileageKm >= 0 && data.startMileageKm <= 10000000))
        && (!('targetMileageKm' in data) || (data.targetMileageKm is number && data.targetMileageKm >= 0 && data.targetMileageKm <= 10000000))
        && (!('currentMileageKm' in data) || (data.currentMileageKm is number && data.currentMileageKm >= 0 && data.currentMileageKm <= 10000000))
        && (!('mileageDueDate' in data) || (data.mileageDueDate is string && data.mileageDueDate.size() <= 32))
        && data.lastPmDate is string && data.lastPmDate.size() <= 32
        && (!('nextPmDate' in data) || (data.nextPmDate is string && data.nextPmDate.size() <= 32))
        && (!('scheduleStatus' in data) || data.scheduleStatus in ['Active', 'Paused'])
        && (!('history' in data) || (data.history is list && data.history.size() <= 50));
    }

    function isValidMhPreStartInspection(data) {
      return data.id is string && data.id.size() <= 128
        && data.vehicleId is string && data.vehicleId.size() > 0 && data.vehicleId.size() <= 64
        && data.inspectionDate is string && data.inspectionDate.size() <= 32
        && (!('mileageKm' in data) || (data.mileageKm is number && data.mileageKm >= 0 && data.mileageKm <= 10000000))
        && (!('operatingHours' in data) || (data.operatingHours is number && data.operatingHours >= 0 && data.operatingHours <= 1000000))
        && (!('items' in data) || (data.items is list && data.items.size() <= 100));
    }

    function isValidWmsEmployee(data) {
      return data.id is string && data.id.size() <= 128
        && data.employeeId is string && data.employeeId.size() <= 64
        && data.employeeName is string && data.employeeName.size() <= 128
        && data.role is string && data.role.size() <= 32
        && data.employmentStatus in ['Active', 'Inactive']
        && (!('allowedSections' in data) || (data.allowedSections is list && data.allowedSections.size() <= 10))
        && (!('workShift' in data) || data.workShift in ['day', 'night'])
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 350000));
    }

    function isValidWmsVehicle(data) {
      return data.id is string && data.id.size() <= 128
        && data.vehicleId is string && data.vehicleId.size() > 0 && data.vehicleId.size() <= 64
        && data.vehicleType is string && data.vehicleType.size() <= 32
        && data.activeStatus in ['Active', 'Inactive']
        && data.operationalStatus is string && data.operationalStatus.size() <= 32
        && (!('description' in data) || (data.description is string && data.description.size() <= 256))
        && (!('registrationNumber' in data) || (data.registrationNumber is string && data.registrationNumber.size() <= 64))
        && (!('department' in data) || (data.department is string && data.department.size() <= 128))
        && (!('capacityTon' in data) || (data.capacityTon is number && data.capacityTon >= 0 && data.capacityTon <= 1000))
        && (!('engineType' in data) || (data.engineType is string && data.engineType.size() <= 128));
    }

    function isValidWmsVehicleAssignment(data) {
      return data.id is string && data.id.size() <= 128
        && data.workingDate is string && data.workingDate.size() <= 32
        && data.vehicleId is string && data.vehicleId.size() <= 64
        && (!('vehicleNumber' in data) || (data.vehicleNumber is string && data.vehicleNumber.size() <= 64))
        && (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 128))
        && (!('status' in data) || (data.status is string && data.status.size() <= 32));
    }

    function isValidWmsActivityLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.employeeId is string && data.employeeId.size() <= 64
        && data.employeeName is string && data.employeeName.size() <= 128
        && data.sectionId is string && data.sectionId.size() <= 32
        && data.module is string && data.module.size() <= 128
        && data.activity is string && data.activity.size() <= 500;
    }

    function isValidSlitEquipmentItem(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.code is string && data.code.size() > 0 && data.code.size() <= 64
        && data.area is string && data.area.size() > 0 && data.area.size() <= 128
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 99999
        && data.status in ['ready', 'repair_needed', 'in_maintenance', 'out_of_service']
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('lastInspector' in data) || (data.lastInspector is string && data.lastInspector.size() <= 128))
        && (!('lastInspectionDate' in data) || (data.lastInspectionDate is string && data.lastInspectionDate.size() <= 64))
        && (!('lastShift' in data) || data.lastShift in ['day', 'night'])
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSlitEquipmentLog(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.equipmentId is string && data.equipmentId.size() > 0 && data.equipmentId.size() <= 128
        && data.equipmentName is string && data.equipmentName.size() > 0 && data.equipmentName.size() <= 128
        && data.equipmentCode is string && data.equipmentCode.size() > 0 && data.equipmentCode.size() <= 64
        && data.area is string && data.area.size() > 0 && data.area.size() <= 128
        && data.inspectionDate is string && data.inspectionDate.size() > 0 && data.inspectionDate.size() <= 32
        && data.shift in ['day', 'night']
        && data.status in ['ready', 'repair_needed', 'in_maintenance', 'out_of_service']
        && data.inspector is string && data.inspector.size() > 0 && data.inspector.size() <= 128
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64
        && (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 500))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSlitWorkforceAssignment(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.workingDate is string && data.workingDate.size() > 0 && data.workingDate.size() <= 32
        && data.employeeName is string && data.employeeName.size() > 0 && data.employeeName.size() <= 128
        && data.shift in ['day', 'night']
        && data.area is string && data.area.size() > 0 && data.area.size() <= 128
        && data.machineGroup in ['TM', 'CF', 'ML', 'ZF']
        && data.duty is string && data.duty.size() > 0 && data.duty.size() <= 128
        && data.status in ['active', 'standby', 'completed']
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 64))
        && (!('department' in data) || (data.department is string && data.department.size() <= 128))
        && (!('machineGroups' in data) || (data.machineGroups is list && data.machineGroups.size() <= 10 && (data.machineGroups.size() == 0 || data.machineGroups[0] is string)))
        && (!('machines' in data) || (data.machines is list && data.machines.size() <= 50 && (data.machines.size() == 0 || data.machines[0] is string)))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('assignedBy' in data) || (data.assignedBy is string && data.assignedBy.size() <= 128))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidWmsWeeklyShiftSchedule(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 32
        && data.weekStartYmd is string && data.weekStartYmd.size() == 10
        && data.weekEndYmd is string && data.weekEndYmd.size() == 10
        && data.workPattern in ['mon_sat', 'mon_sun']
        && data.entries is map && data.entries.size() <= 1000
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    match /slit_inbound/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidInboundRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /slit_outbound/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidOutboundRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /slit_picklists/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) && isValidPickList(request.resource.data);
      allow delete: if isValidId(orderId);
    }

    match /slit_sap_chunks/{chunkId} {
      allow read: if true;
      allow create, update: if isValidId(chunkId) && isValidSapChunk(request.resource.data);
      allow delete: if isValidId(chunkId);
    }

    match /slit_space_config/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && isValidSpaceConfig(request.resource.data);
      allow delete: if isValidId(configId);
    }

    match /slit_equipment_items/{equipmentId} {
      allow read: if true;
      allow create, update: if isValidId(equipmentId) && isValidSlitEquipmentItem(request.resource.data);
      allow delete: if isValidId(equipmentId);
    }

    match /slit_equipment_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && isValidSlitEquipmentLog(request.resource.data);
      allow delete: if isValidId(logId);
    }

    match /slit_workforce_assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isValidId(assignmentId) && isValidSlitWorkforceAssignment(request.resource.data);
      allow delete: if isValidId(assignmentId);
    }

    match /coil_stock/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidCoilStock(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /coil_transactions/{txId} {
      allow read: if true;
      allow create, update: if isValidId(txId) && isValidCoilTransaction(request.resource.data);
      allow delete: if isValidId(txId);
    }

    match /coil_staging/{stagingId} {
      allow read: if true;
      allow create, update: if isValidId(stagingId) && isValidCoilStaging(request.resource.data);
      allow delete: if isValidId(stagingId);
    }

    match /coil_layouts/{layoutId} {
      allow read: if true;
      allow create, update: if isValidId(layoutId) && isValidCoilLayout(request.resource.data);
      allow delete: if isValidId(layoutId);
    }

    match /coil_sap_chunks/{chunkId} {
      allow read: if true;
      allow create, update: if isValidId(chunkId) && isValidCoilSapChunk(request.resource.data);
      allow delete: if isValidId(chunkId);
    }

    match /rm_stock/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidRmStock(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /rm_transactions/{txId} {
      allow read: if true;
      allow create, update: if isValidId(txId) && isValidRmTransaction(request.resource.data);
      allow delete: if isValidId(txId);
    }

    match /rm_staging/{stagingId} {
      allow read: if true;
      allow create, update: if isValidId(stagingId) && isValidRmStaging(request.resource.data);
      allow delete: if isValidId(stagingId);
    }

    match /rm_layouts/{layoutId} {
      allow read: if true;
      allow create, update: if isValidId(layoutId) && isValidRmLayout(request.resource.data);
      allow delete: if isValidId(layoutId);
    }

    match /rm_sap_chunks/{chunkId} {
      allow read: if true;
      allow create, update: if isValidId(chunkId) && isValidRmSapChunk(request.resource.data);
      allow delete: if isValidId(chunkId);
    }

    match /mh_transfers/{transferId} {
      allow read: if true;
      allow create, update: if isValidId(transferId) && isValidMhTransfer(request.resource.data);
      allow delete: if isValidId(transferId);
    }

    match /mh_maintenance/{maintenanceId} {
      allow read: if true;
      allow create, update: if isValidId(maintenanceId) && isValidMhMaintenance(request.resource.data);
      allow delete: if isValidId(maintenanceId);
    }

    match /mh_fuel_stock/{fuelTxId} {
      allow read: if true;
      allow create, update: if isValidId(fuelTxId) && isValidMhFuelStock(request.resource.data);
      allow delete: if isValidId(fuelTxId);
    }

    match /mh_tire_stock/{tireTxId} {
      allow read: if true;
      allow create, update: if isValidId(tireTxId) && isValidMhTireStock(request.resource.data);
      allow delete: if isValidId(tireTxId);
    }

    match /mh_daily_duty/{dutyId} {
      allow read: if true;
      allow create, update: if isValidId(dutyId) && isValidMhDailyDuty(request.resource.data);
      allow delete: if isValidId(dutyId);
    }

    match /mh_delivery_points/{pointId} {
      allow read: if true;
      allow create, update: if isValidId(pointId) && isValidMhDeliveryPoint(request.resource.data);
      allow delete: if isValidId(pointId);
    }

    match /mh_pm_schedules/{scheduleId} {
      allow read: if true;
      allow create, update: if isValidId(scheduleId) && isValidMhPmSchedule(request.resource.data);
      allow delete: if isValidId(scheduleId);
    }

    match /mh_prestart_inspections/{inspectionId} {
      allow read: if true;
      allow create, update: if isValidId(inspectionId) && isValidMhPreStartInspection(request.resource.data);
      allow delete: if isValidId(inspectionId);
    }

    match /wms_employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidId(employeeId) && isValidWmsEmployee(request.resource.data);
      allow delete: if isValidId(employeeId);
    }

    match /wms_vehicles/{vehicleId} {
      allow read: if true;
      allow create, update: if isValidId(vehicleId) && isValidWmsVehicle(request.resource.data);
      allow delete: if isValidId(vehicleId);
    }

    match /wms_vehicle_assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isValidId(assignmentId) && isValidWmsVehicleAssignment(request.resource.data);
      allow delete: if isValidId(assignmentId);
    }

    match /wms_activity_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && isValidWmsActivityLog(request.resource.data);
      allow delete: if isValidId(logId);
    }

    match /wms_weekly_shift_schedules/{weekId} {
      allow read: if true;
      allow create, update: if isValidId(weekId) && isValidWmsWeeklyShiftSchedule(request.resource.data);
      allow delete: if isValidId(weekId);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
